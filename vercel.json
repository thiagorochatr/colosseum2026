{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/zk/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/tempo",
      "destination": "/index.html"
    },
    {
      "source": "/tempo/",
      "destination": "/index.html"
    },
    {
      "source": "/solana",
      "destination": "/index.html"
    },
    {
      "source": "/solana/",
      "destination": "/index.html"
    }
  ]
}
